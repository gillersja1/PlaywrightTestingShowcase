<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <Playwright>
    <!-- Overridden in CI via: dotnet test (use the settings option and Playwright.BrowserName=firefox) -->
    <BrowserName>chromium</BrowserName>
    <ExpectTimeout>5000</ExpectTimeout>
    <LaunchOptions>
      <Headless>true</Headless>
    </LaunchOptions>
    <!-- Record video for all tests -->
    <RecordVideo>on</RecordVideo>
    <!-- Record trace for debugging -->
    <RecordTrace>on</RecordTrace>
  </Playwright>
</RunSettings>
