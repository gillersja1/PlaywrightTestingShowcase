{"files":{"/home/runner/work/PlaywrightTestingShowcase/PlaywrightTestingShowcase/src/CalculatorLib/Calculator.cs":{"language":"cs","source":"namespace CalculatorLib;\n\n/// \u003Csummary\u003E\n/// A small, deliberately simple class used as the \u0022system under test\u0022\n/// for demonstrating unit testing patterns in this repo.\n/// \u003C/summary\u003E\npublic class Calculator\n{\n    public double Add(double a, double b) =\u003E a \u002B b;\n\n    public double Subtract(double a, double b) =\u003E a - b;\n\n    public double Multiply(double a, double b) =\u003E a * b;\n\n    public double Divide(double a, double b)\n    {\n        if (b == 0)\n        {\n            throw new DivideByZeroException(\u0022Cannot divide by zero.\u0022);\n        }\n\n        return a / b;\n    }\n\n    public bool IsPrime(int number)\n    {\n        if (number \u003C 2)\n        {\n            return false;\n        }\n\n        for (var i = 2; i \u003C= Math.Sqrt(number); i\u002B\u002B)\n        {\n            if (number % i == 0)\n            {\n                return false;\n            }\n        }\n\n        return true;\n    }\n}\n","mutants":[{"id":"0","mutatorName":"Arithmetic mutation","replacement":"a - b","location":{"start":{"line":9,"column":46},"end":{"line":9,"column":51}},"status":"Killed","static":false,"coveredBy":["021d66d8-b5fb-bc17-9d15-f55c29ff0b17","0033219c-9519-4d8b-77c7-bfe2ca1e7dc7","092280ca-aee1-7bea-402a-cf9604526e59","9f6bcda9-c12f-78a5-a72a-a427a9a75b8b"],"killedBy":["021d66d8-b5fb-bc17-9d15-f55c29ff0b17","0033219c-9519-4d8b-77c7-bfe2ca1e7dc7","9f6bcda9-c12f-78a5-a72a-a427a9a75b8b"]},{"id":"1","mutatorName":"Arithmetic mutation","replacement":"a \u002B b","location":{"start":{"line":11,"column":51},"end":{"line":11,"column":56}},"status":"Killed","static":false,"coveredBy":["160051b2-cc51-66d0-e416-49351874aa3d","5391738f-303e-be5e-1cf2-378db8b9e41f"],"killedBy":["160051b2-cc51-66d0-e416-49351874aa3d","5391738f-303e-be5e-1cf2-378db8b9e41f"]},{"id":