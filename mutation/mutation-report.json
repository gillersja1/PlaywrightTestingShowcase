3CDivideByZeroException\u003E(() =\u003E _calculator.Divide(10, 0));\n\n        // Checking the message too: Stryker showed that blanking it went unnoticed.\n        Assert.That(error!.Message, Is.EqualTo(\u0022Cannot divide by zero.\u0022));\n    }\n\n    [TestCase(2, true)]\n    [TestCase(4, false)]\n    [TestCase(17, true)]\n    [TestCase(1, false)]\n    [TestCase(0, false)]\n    [TestCase(-3, false)]\n    public void IsPrime_ReturnsExpectedResult(int number, bool expected)\n    {\n        Assert.That(_calculator.IsPrime(number), Is.EqualTo(expected));\n    }\n}\n","tests":[{"id":"021d66d8-b5fb-bc17-9d15-f55c29ff0b17","name":"CalculatorLib.UnitTests.CalculatorTests.Add_ReturnsExpectedSum(2,3,5)","location":{"start":{"line":19,"column":5},"end":{"line":26,"column":6}}},{"id":"0033219c-9519-4d8b-77c7-bfe2ca1e7dc7","name":"CalculatorLib.UnitTests.CalculatorTests.Add_ReturnsExpectedSum(-1,1,0)","location":{"start":{"line":19,"column":5},"end":{"line":26,"column":6}}},{"id":"092280ca-aee1-7bea-402a-cf9604526e59","name":"CalculatorLib.UnitTests.CalculatorTests.Add_ReturnsExpectedSum(0,0,0)","location":{"start":{"line":19,"column":5},"end":{"line":26,"column":6}}},{"id":"9f6bcda9-c12f-78a5-a72a-a427a9a75b8b","name":"CalculatorLib.UnitTests.CalculatorTests.Add_ReturnsExpectedSum(-5,-5,-10)","location":{"start":{"line":19,"column":5},"end":{"line":26,"column":6}}},{"id":"77a4437e-cb06-ed92-fadc-667b063ed02c","name":"CalculatorLib.UnitTests.CalculatorTests.Divide_ByNonZero_ReturnsQuotient","location":{"start":{"line":42,"column":5},"end":{"line":46,"column":6}}},{"id":"ffa4bca9-127d-2726-2964-50fba9193399","name":"CalculatorLib.UnitTests.CalculatorTests.Divide_ByZero_ThrowsDivideByZeroException","location":{"start":{"line":48,"column":5},"end":{"line":55,"column":6}}},{"id":"9fb55b2f-ac0c-de27-5518-c161a40595e1","name":"CalculatorLib.UnitTests.CalculatorTests.IsPrime_ReturnsExpectedResult(2,True)","location":{"start":{"line":57,"column":5},"end":{"line":66,"column":6}}},{"